# VCDC Operations Hub environment variables.
# Copy to .env.local for local dev. Mark sets production values in Vercel.
# lib/env.ts validates required vars at startup and names anything missing.

# ---------- Required from Slice 1 ----------

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Pooled (transaction mode) connection string for Drizzle,
# from Supabase settings -> Database -> Connection pooling.
DATABASE_URL=

# Canonical app URL, no trailing slash. http://localhost:3000 in dev.
NEXT_PUBLIC_APP_URL=
# Bootstrap admin email. The seed script grants this user the admin role.
ADMIN_EMAIL=

# ---------- Not needed until later slices ----------

# QR signing (Slice 5): 32+ random bytes hex, e.g. `openssl rand -hex 32`
QR_SIGNING_SECRET=

# Resend (Slice 7). Email degrades to a no-op when RESEND_API_KEY is absent.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Public waiver URL (Slice 8). Placeholder until the short-domain decision.
NEXT_PUBLIC_WAIVER_URL=

# Apple Wallet (Slice 2), all certs base64 because Vercel has no writable disk
APPLE_WWDR_CERT_B64=
APPLE_PASS_CERT_P12_B64=
APPLE_PASS_CERT_PASSWORD=
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=

# Google Wallet (Slice 3)
GOOGLE_WALLET_SERVICE_ACCOUNT_B64=
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CLASS_ID=
